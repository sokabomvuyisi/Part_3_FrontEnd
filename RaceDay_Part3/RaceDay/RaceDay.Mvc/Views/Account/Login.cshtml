@model RaceDay.Contracts.LoginRequest
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-raceday">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold"><i class="bi bi-box-arrow-in-right me-2 text-danger"></i>Login</h3>
                <form asp-action="Login" method="post" class="form-raceday" novalidate>
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-raceday w-100">Login</button>
                </form>
                <p class="text-center mt-3 mb-0">
                    Don't have an account? <a asp-action="Register">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
