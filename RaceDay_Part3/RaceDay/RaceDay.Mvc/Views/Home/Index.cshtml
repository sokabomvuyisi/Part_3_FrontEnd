@{
    ViewData["Title"] = "Welcome";
}
<div class="hero-raceday text-center">
    <div class="container position-relative">
        <h1 class="mb-3"><i class="bi bi-trophy-fill text-danger"></i> RaceDay</h1>
        <p class="lead mb-4">Organise races. Enrol. Compete. Track your results.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="btn btn-raceday btn-lg px-4">Get Started</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4">Login</a>
        </div>
    </div>
</div>

<div class="row g-4 text-center mb-5">
    <div class="col-md-4">
        <div class="card-raceday h-100 p-4">
            <div class="mb-3" style="font-size:2.5rem;color:#ef4444;"><i class="bi bi-calendar-plus"></i></div>
            <h5 class="fw-bold">Create Events</h5>
            <p class="text-muted-rd mb-0">Organisers create races, manage categories, enrolments and publish results.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-raceday h-100 p-4">
            <div class="mb-3" style="font-size:2.5rem;color:#ef4444;"><i class="bi bi-person-check"></i></div>
            <h5 class="fw-bold">Enrol & Compete</h5>
            <p class="text-muted-rd mb-0">Participants browse events, enrol in categories and track their race history.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-raceday h-100 p-4">
            <div class="mb-3" style="font-size:2.5rem;color:#ef4444;"><i class="bi bi-cloud-upload"></i></div>
            <h5 class="fw-bold">Cloud Powered</h5>
            <p class="text-muted-rd mb-0">Images stored securely in Azure Blob Storage via the API.</p>
        </div>
    </div>
</div>
