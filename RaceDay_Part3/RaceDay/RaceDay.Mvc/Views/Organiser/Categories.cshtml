@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}
<div class="page-header">
    <h2><i class="bi bi-tags me-2 text-danger"></i>Categories for Event #@Model.EventId</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back to Dashboard</a>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card-raceday">
            <div class="card-body p-4">
                <h5 class="section-title">Add Category</h5>
                <form asp-action="AddCategory" method="post" class="form-raceday" novalidate>
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.Name">Name *</label>
                        <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. Under 20, 10km" />
                        <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.Description">Description</label>
                        <input asp-for="NewCategory.Description" class="form-control" />
                        <span asp-validation-for="NewCategory.Description" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-raceday">Add Category</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        @if (!Model.Categories.Any())
        {
            <div class="empty-state">
                <i class="bi bi-tags"></i>
                <h4>No categories yet</h4>
                <p class="text-muted-rd mb-0">Add a category so participants can enrol.</p>
            </div>
        }
        else
        {
            <div class="table-responsive table-raceday">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Name</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td><strong>@c.Name</strong></td>
                            <td>@c.Description</td>
                            <td class="text-end">
                                <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@c.CategoryId" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
