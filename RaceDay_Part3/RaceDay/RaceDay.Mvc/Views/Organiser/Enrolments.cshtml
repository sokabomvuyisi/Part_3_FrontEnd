@model List<EnrolmentDto>
@{
    ViewData["Title"] = "Enrolments";
    var eventId = (int)ViewBag.EventId;
}
<div class="page-header">
    <h2><i class="bi bi-people me-2 text-danger"></i>Enrolments</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back to Dashboard</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h4>No enrolments yet</h4>
        <p class="text-muted-rd">Participants will appear here once they enrol.</p>
    </div>
}
else
{
    <div class="table-responsive table-raceday">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Enrolled</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><strong>@e.ParticipantName</strong></td>
                    <td>@e.CategoryName</td>
                    <td>
                        <span class="badge-status @(e.Status == "Confirmed" ? "badge-confirmed" : e.Status == "Pending" ? "badge-pending" : "badge-cancelled")">
                            @e.Status
                        </span>
                    </td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        @if (e.Status != "Confirmed")
                        {
                            <form asp-action="UpdateEnrolmentStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@e.EnrolmentId" />
                                <input type="hidden" name="eventId" value="@eventId" />
                                <input type="hidden" name="status" value="Confirmed" />
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-success">Confirm</button>
                            </form>
                        }
                        @if (e.Status != "Cancelled")
                        {
                            <form asp-action="UpdateEnrolmentStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@e.EnrolmentId" />
                                <input type="hidden" name="eventId" value="@eventId" />
                                <input type="hidden" name="status" value="Cancelled" />
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
