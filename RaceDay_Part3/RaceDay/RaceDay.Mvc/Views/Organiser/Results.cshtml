@model List<EnrolmentDto>
@{
    ViewData["Title"] = "Results Entry";
    var eventId = (int)ViewBag.EventId;
    var results = ViewBag.Results as List<ResultDto> ?? new List<ResultDto>();
    var confirmed = Model.Where(x => x.Status == "Confirmed").ToList();
}
<div class="page-header">
    <h2><i class="bi bi-stopwatch me-2 text-danger"></i>Results for Event #@eventId</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back to Dashboard</a>
</div>

@if (!confirmed.Any())
{
    <div class="empty-state">
        <i class="bi bi-stopwatch"></i>
        <h4>No confirmed participants</h4>
        <p class="text-muted-rd mb-0">Confirm enrolments first, then record finish times and positions here.</p>
    </div>
}
else
{
    <div class="table-responsive table-raceday">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in confirmed)
            {
                var existing = results.FirstOrDefault(r => r.EnrolmentId == e.EnrolmentId);
                var formId = "row-" + e.EnrolmentId;
                <tr>
                    <td><strong>@e.ParticipantName</strong></td>
                    <td>@e.CategoryName</td>
                    <td><span class="badge-status badge-confirmed">Confirmed</span></td>
                    @if (existing != null)
                    {
                        <td><code>@existing.FinishTime.ToString(@"hh\:mm\:ss")</code></td>
                        <td>@existing.Position</td>
                        <td class="text-end"><span class="badge-status badge-confirmed">Recorded</span></td>
                    }
                    else
                    {
                        @* The form lives inside ONE cell (an HTML <form> cannot sit directly inside a <tr>).
                           The inputs in the other cells are linked to it with the form="..." attribute. *@
                        <td>
                            <input form="@formId" name="finishTime" class="form-control form-control-sm"
                                   placeholder="00:45:30" pattern="\d{1,2}:[0-5]\d:[0-5]\d" title="Use the format hh:mm:ss" required />
                        </td>
                        <td>
                            <input form="@formId" name="position" type="number" class="form-control form-control-sm" min="1" required />
                        </td>
                        <td class="text-end">
                            <form id="@formId" asp-action="AddResult" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@eventId" />
                                <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-raceday">Save</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
