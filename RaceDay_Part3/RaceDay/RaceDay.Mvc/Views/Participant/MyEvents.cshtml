@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My Events";
}
<div class="page-header">
    <h2><i class="bi bi-bookmark-check me-2 text-danger"></i>My Enrolled Events</h2>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-bookmark"></i>
        <h4>No enrolments yet</h4>
        <p class="text-muted-rd">Browse events and enrol to see them here.</p>
        <a asp-action="Index" class="btn btn-raceday mt-2">Browse Events</a>
    </div>
}
else
{
    <div class="table-responsive table-raceday">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Enrolled On</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><strong>@e.EventName</strong></td>
                    <td>@e.CategoryName</td>
                    <td>
                        <span class="badge-status @(e.Status == "Confirmed" ? "badge-confirmed" : e.Status == "Pending" ? "badge-pending" : "badge-cancelled")">
                            @e.Status
                        </span>
                    </td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
